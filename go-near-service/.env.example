# UPRAIL NEAR Go Settlement Service configuration template
# Copy to .env for local development: cp .env.example .env

# Inter-service authentication secret between Cloudflare Worker and Go service
# MUST match INTERNAL_SERVICE_KEY configured in worker/.dev.vars and wrangler secrets.
INTERNAL_SERVICE_KEY="uprail_confidential_master_sig_2026"

# Escrow NEAR account ID and master private key
# Root ML-DSA-65 or Ed25519 private key
ESCROW_ACCOUNT_ID="escrow.uprail.near"
ESCROW_PRIVATE_KEY=""

# Port and environment
PORT="8080"
ENVIRONMENT="development"

# 1Click Swap API & Solver Relay endpoints
NEAR_API_BASE="https://1click.chaindefuser.com"
SOLVER_RELAY_URL="https://solver-relay-v2.chaindefuser.com/rpc"

# Optional: Account creation rules
ALLOWED_ACCOUNT_PARENTS="uprail.near"
DENIED_ACCOUNT_IDS="escrow.uprail.near,fees.uprail.near,uprail.near"
