{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uprail-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "X_CLIENT_ID": "UHZFT2JxeEhZeEFqWTc2QzUxY2E6MTpjaQ",
    "X_CLIENT_SECRET": "Uzwwmc2W6Yd5MaQXxTXXZyRnz42kIsmygR7fGV2EdD_FccBRjr",
    "SESSION_SECRET": "d083cdb5bc9d70c9e0e5f70ad08ed1858e3c0a4b097281564a60b493e9d8fdb9",
    "INTERNAL_SERVICE_KEY": "uprail_confidential_master_sig_2026",
    "ESCROW_PRIVATE_KEY": "ed25519:3tgX4A9y7J55RUf1JMtvqBWdPNRk8BNLtNucwmSBz3Rgj4ELzs1pgya17u7wTuuJJkJTPESpWWsQukVr2AExFWkQ",
    "NEAR_API_BASE": "https://1click.chaindefuser.com",
    "SOLVER_RELAY_URL": "https://solver-relay-v2.chaindefuser.com/rpc",
    "NEAR_RPC_URL": "https://nameless-practical-liquid.near-mainnet.quiknode.pro/764c7b41d38ccdf55377d79578d11c41efa0a3b8/",
    "INTENTS_CONTRACT_ID": "intents.near",
    "ESCROW_ACCOUNT_ID": "escrow.uprail.near",
    "MASTER_ACCOUNT_ID": "uprail.near",
    "FEE_ACCOUNT_ID": "fees.uprail.near",
    "FEE_PERCENT": "0.008",
    "PAYMENT_EXPIRY_DAYS": "30",
    "WEBAUTHN_RP_ID": "uprail.world",
    "WEBAUTHN_RP_NAME": "UPRAIL",
    "WEBAUTHN_ORIGIN": "https://app.uprail.world"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "api.uprail.world", "custom_domain": true },
    { "pattern": "app.uprail.world", "custom_domain": true },
    { "pattern": "uprail.world/*", "zone_name": "uprail.world" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uprail-db",
      "database_id": "0d6f8300-67cb-4a82-9b38-33f5a0342edd"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "45901b063153427da3bf4e668d996d91"
    }
  ]
}
