{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uprail-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    // Full sampling: volume is low (~5k requests/day), so complete logs cost
    // little and a sampled-out 5xx would be exactly the one we need.
    "head_sampling_rate": 1.0
  },
  // ---------------------------------------------------------------------------
  // NON-SECRET configuration only.
  //
  // Secrets must never be committed here. Configure them with:
  //   Production : wrangler secret put <NAME>      (see .dev.vars.example)
  //   Local dev  : cp .dev.vars.example .dev.vars  then fill in real values
  //
  // The worker FAILS CLOSED when a required secret is missing — requests that
  // need it return an error instead of falling back to a default value.
  // ---------------------------------------------------------------------------
  "vars": {
    "X_CLIENT_ID": "UHZFT2JxeEhZeEFqWTc2QzUxY2E6MTpjaQ",
    "NEAR_API_BASE": "https://1click.chaindefuser.com",
    "SOLVER_RELAY_URL": "https://solver-relay-v2.chaindefuser.com/rpc",
    "INTENTS_CONTRACT_ID": "intents.near",
    "ESCROW_ACCOUNT_ID": "escrow.uprail.near",
    "MASTER_ACCOUNT_ID": "uprail.near",
    // Fees are routed to escrow.uprail.near, not fees.uprail.near. Intents
    // only accepts a signed transfer intent to an account with a public key
    // registered on the contract, and neither fees.uprail.near nor uprail.near
    // has one — every fee transfer to them failed, silently, and
    // fees.uprail.near has held 0.000000 NEAR since it was created. Escrow is
    // the one platform account registered on intents, so it is the only
    // destination that actually receives. FEE_ACCOUNT_ID can still override
    // this once a treasury account is registered on intents.
    "FEE_ACCOUNT_ID": "escrow.uprail.near",
    "FEE_PERCENT": "0.05",
    // Creator-fee dust guard. A launchpad fee whose USD value is known and below
    // this is held (claimable) instead of spending escrow gas settling dust.
    "MIN_FEE_USD": "1",
    // Daily cap on escrow registrations triggered by the unauthenticated
    // zero-integration fee path, bounding gas a stranger can make escrow spend.
    "PUBLIC_REG_DAILY_CAP": "50",
    // Daily registration cap per self-serve launchpad parent account.
    "LAUNCHPAD_DAILY_REG_CAP": "100",
    "PAYMENT_EXPIRY_DAYS": "30",
    "WEBAUTHN_RP_ID": "uprail.world",
    "WEBAUTHN_RP_NAME": "UPRAIL",
    "WEBAUTHN_ORIGIN": "https://app.uprail.world",
    // OAuth 2.1 authorization server + MCP resource. Override locally if needed.
    "OAUTH_ISSUER": "https://app.uprail.world",
    "OAUTH_RESOURCE": "https://api.uprail.world/api/mcp"
  },
  // Secrets (set via `wrangler secret put NAME`, never committed):
  //   X_CLIENT_SECRET, SESSION_SECRET, INTERNAL_SERVICE_KEY,
  //   ESCROW_PRIVATE_KEY, NEAR_RPC_URL, SETTLEMENT_SERVICE_URL
  //
  // SETTLEMENT_SERVICE_URL is how the worker reaches the Go settlement
  // service. No durable_objects/containers block is declared: this worker is
  // deployed on the free tier, which cannot run Worker containers.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "api.uprail.world", "custom_domain": true },
    { "pattern": "app.uprail.world", "custom_domain": true },
    { "pattern": "docs.uprail.world", "custom_domain": true },
    { "pattern": "uprail.world/*", "zone_name": "uprail.world" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uprail-db",
      "database_id": "0d6f8300-67cb-4a82-9b38-33f5a0342edd"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "45901b063153427da3bf4e668d996d91"
    },
    {
      "binding": "OAUTH_KV",
      "id": "a7ae2e9c6ff94c4791c95292c36a14f9"
    }
  ]
}
