{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uprail-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "X_CLIENT_ID": "UHZFT2JxeEhZeEFqWTc2QzUxY2E6MTpjaQ",
    "NEAR_API_BASE": "https://1click.chaindefuser.com",
    "SOLVER_RELAY_URL": "https://solver-relay-v2.chaindefuser.com/rpc",
    "NEAR_RPC_URL": "https://nameless-practical-liquid.near-mainnet.quiknode.pro/764c7b41d38ccdf55377d79578d11c41efa0a3b8/",
    "INTENTS_CONTRACT_ID": "intents.near",
    "ESCROW_ACCOUNT_ID": "escrow.uprail.near",
    "MASTER_ACCOUNT_ID": "uprail.near",
    "FEE_ACCOUNT_ID": "fees.uprail.near",
    "FEE_PERCENT": "0.008",
    "PAYMENT_EXPIRY_DAYS": "30",
    "WEBAUTHN_RP_ID": "uprail.world",
    "WEBAUTHN_RP_NAME": "UPRAIL",
    "WEBAUTHN_ORIGIN": "https://app.uprail.world",
    "DATABASE_URL": "postgres://postgres@localhost:5432/uprail"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ESCROW",
        "class_name": "EscrowDO"
      },
      {
        "name": "NEAR_CONTAINER",
        "class_name": "NearContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EscrowDO"]
    }
  ],
  "containers": {
    "app": [
      {
        "name": "near-service",
        "instances": 1,
        "configuration": {
          "image": "./go-near-service/Dockerfile"
        }
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uprail-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000"
    }
  ]
}
