{
  "name": "uprail-worker",
  "version": "1.0.0",
  "description": "Confidential payment system for X (Twitter) handles using NEAR and WebAuthn",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/index.ts --bundle --format=esm --main-fields=module,main --outfile=dist/worker.js --external:cloudflare:workers && node --test test/miniflare.test.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.0.0",
    "hono": "^4.7.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "wrangler": "^3.80.0"
  }
}
