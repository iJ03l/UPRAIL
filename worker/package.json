{
  "name": "uprail-worker",
  "version": "1.0.0",
  "description": "Confidential payment system for X (Twitter) handles using NEAR and WebAuthn",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/index.ts --bundle --format=esm --main-fields=module,main --outfile=dist/worker.js --external:cloudflare:workers --alias:os=./src/db/os-stub.ts --alias:fs=./src/db/fs-stub.ts --alias:net=./src/db/net-stub.ts --alias:tls=./src/db/tls-stub.ts --alias:perf_hooks=./src/db/perf_hooks-stub.ts --alias:crypto=./src/db/crypto-stub.ts --alias:stream=node:stream --external:node:* && node --test test/miniflare.test.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.0.0",
    "hono": "^4.7.0",
    "postgres": "^3.4.9",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "wrangler": "^3.80.0"
  }
}
